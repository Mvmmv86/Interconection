# ===========================================
# Interconection Treasury MGMT - Backend
# ===========================================
# Copy this file to .env and configure

# -------------------------------------------
# APPLICATION
# -------------------------------------------
APP_NAME=Interconection
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# -------------------------------------------
# DATABASE (PostgreSQL)
# -------------------------------------------
# Local development:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/interconection

# Supabase (uncomment and configure):
# DATABASE_URL=postgresql+asyncpg://postgres.your_project:password@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# -------------------------------------------
# REDIS
# -------------------------------------------
REDIS_URL=redis://localhost:6379

# -------------------------------------------
# SECURITY
# -------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# RBAC Rollout (use true only after endpoint validation)
# -------------------------------------------
RBAC_ENFORCEMENT_V1=false
# Suggested full v1 rollout after per-module proof:
# RBAC_ENFORCEMENT_V1_ENDPOINTS=clients,wallets,manual-assets,positions,exchange,settings,portfolio,analytics
RBAC_ENFORCEMENT_V1_ENDPOINTS=
RBAC_SCOPE_SPECIFIC=false
# Suggested scope rollout after specific/all proof:
# RBAC_SCOPE_SPECIFIC_ENDPOINTS=clients,wallets,manual-assets,positions,exchange,portfolio,analytics
RBAC_SCOPE_SPECIFIC_ENDPOINTS=

# -------------------------------------------
# CORS
# -------------------------------------------
CORS_ORIGINS=http://localhost:3003,http://localhost:3004

# -------------------------------------------
# CELERY (Background Tasks)
# -------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -------------------------------------------
# BOT SCHEDULER (Paper bots)
# -------------------------------------------
# Keep disabled until migrations, candle ingestion and smoke tests are confirmed.
BOT_SCHEDULER_ENABLED=false
BOT_SCHEDULER_INTERVAL_SECONDS=60
BOT_SCHEDULER_BATCH_LIMIT=50
BOT_SCHEDULER_CANDLE_LIMIT=300

# Public market scanner feeder for bot baskets/rankings.
# Keep disabled until exchange API quotas and smoke tests are confirmed.
BOT_MARKET_SCANNER_ENABLED=false
BOT_MARKET_SCANNER_INTERVAL_SECONDS=900
BOT_MARKET_SCANNER_EXCHANGE=bingx
BOT_MARKET_SCANNER_MARKET_TYPE=futures
BOT_MARKET_SCANNER_QUOTE_ASSET=USDT
BOT_MARKET_SCANNER_UNIVERSE_LIMIT=120
BOT_MARKET_SCANNER_CANDLE_SYMBOL_LIMIT=50
BOT_MARKET_SCANNER_TOP_N=50

# -------------------------------------------
# EXTERNAL APIS
# -------------------------------------------
# CoinGecko (required for prices)
COINGECKO_API_KEY=

# Blockchain Providers
INFURA_API_KEY=
ALCHEMY_API_KEY=
HELIUS_API_KEY=

# -------------------------------------------
# EMAIL (Optional)
# -------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@interconection.io

# -------------------------------------------
# ENCRYPTION
# -------------------------------------------
# For encrypting API keys in database
# Generate with: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
ENCRYPTION_KEY=
